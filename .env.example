# --- LLM (OpenRouter) ---
# Get a key at https://openrouter.ai/keys . Without it the app runs in
# clearly-labeled demo mode (extractive answers from sources, no generation).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Public URL of the deployed app (sent as HTTP-Referer to OpenRouter)
APP_PUBLIC_URL=http://localhost:8000

# Token required by POST /api/admin/refresh (leave empty to disable refresh)
ADMIN_TOKEN=
